  "segments": [
    {
      "idx": 0,
      "speaker": "temsilci",
      "start": 1.0,
      "end": 5.8,
      "text": "Netik İletişim, ben Fatih. Görüşmemiz kayıt altına alınmakta, verileriniz KVKK kapsamında işlenmektedir."
    },
    {
      "idx": 1,
      "speaker": "temsilci",
      "start": 6.15,
      "end": 8.55,
      "text": "Adınızı ve müşteri numaranızı alabilir miyim?"
    },
    {
      "idx": 2,
      "speaker": "musteri",
      "start": 8.9,
      "end": 10.1,
      "text": "Emre Kılıç, 119003."
    },
    {
      "idx": 3,
      "speaker": "temsilci",
      "start": 10.45,
      "end": 11.65,
      "text": "Teşekkürler."
    },
    {
      "idx": 4,
      "speaker": "musteri",
      "start": 12.0,
      "end": 14.4,
      "text": "Babam vefat etti, hattını kapatmam gerekiyor."
    },
    {
      "idx": 5,
      "speaker": "temsilci",
      "start": 14.75,
      "end": 17.15,
      "text": "Vefat işlemi için veraset ilamı gerekiyor."
    },
    {
      "idx": 6,
      "speaker": "musteri",
      "start": 17.5,
      "end": 18.7,
      "text": "Nereye götüreceğim?"
    },
    {
      "idx": 7,
      "speaker": "temsilci",
      "start": 19.05,
      "end": 20.25,
      "text": "Bayiye."
    },
    {
      "idx": 8,
      "speaker": "musteri",
      "start": 20.6,
      "end": 21.8,
      "text": "Peki."
    },
    {
      "idx": 9,
      "speaker": "temsilci",
      "start": 22.15,
      "end": 24.15,
      "text": "Başka bir şey var mı?"
    },
    {
      "idx": 10,
      "speaker": "musteri",
      "start": 24.5,
      "end": 25.7,
      "text": "Yok."
    },
    {
      "idx": 11,
      "speaker": "temsilci",
      "start": 26.05,
      "end": 27.25,
      "text": "İyi günler."
    }
  ]
