      "idx": 0,
      "speaker": "temsilci",
      "start": 1.0,
      "end": 5.8,
      "text": "Netik İletişim, ben Nazlı. Görüşmemiz kayıt altına alınmakta, verileriniz KVKK kapsamında işlenmektedir."
    },
    {
      "idx": 1,
      "speaker": "musteri",
      "start": 6.15,
      "end": 8.55,
      "text": "Hattımdaki tüm ek paketleri iptal edin."
    },
    {
      "idx": 2,
      "speaker": "temsilci",
      "start": 8.9,
      "end": 10.1,
      "text": "Hemen iptal ediyorum."
    },
    {
      "idx": 3,
      "speaker": "musteri",
      "start": 10.45,
      "end": 12.45,
      "text": "Bir de fatura adresimi değiştirin."
    },
    {
      "idx": 4,
      "speaker": "temsilci",
      "start": 12.8,
      "end": 14.4,
      "text": "Yeni adresi söyleyin, güncelleyeyim."
    },
    {
      "idx": 5,
      "speaker": "musteri",
      "start": 14.75,
      "end": 16.35,
      "text": "Bağdat Caddesi No 12."
    },
    {
      "idx": 6,
      "speaker": "temsilci",
      "start": 16.7,
      "end": 17.9,
      "text": "Güncelledim."
    },
    {
      "idx": 7,
      "speaker": "temsilci",
      "start": 18.25,
      "end": 21.05,
      "text": "Başka yardımcı olabileceğim bir konu var mı?"
    },
    {
      "idx": 8,
      "speaker": "musteri",
      "start": 21.4,
      "end": 22.6,
      "text": "Yok, teşekkürler."
    },
    {
      "idx": 9,
      "speaker": "temsilci",
      "start": 22.95,
      "end": 25.75,
      "text": "Aradığınız için teşekkür ederim, iyi günler dilerim."
    }
  ]
