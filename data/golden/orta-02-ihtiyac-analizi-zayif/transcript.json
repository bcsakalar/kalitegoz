      "start": 1.0,
      "end": 5.8,
      "text": "Netik İletişim, ben Pınar. Görüşmemiz kayıt altına alınmakta, verileriniz KVKK kapsamında işlenmektedir."
    },
    {
      "idx": 1,
      "speaker": "temsilci",
      "start": 6.15,
      "end": 8.55,
      "text": "Adınızı ve müşteri numaranızı alabilir miyim?"
    },
    {
      "idx": 2,
      "speaker": "musteri",
      "start": 8.9,
      "end": 10.1,
      "text": "Sema Toprak, 334512."
    },
    {
      "idx": 3,
      "speaker": "temsilci",
      "start": 10.45,
      "end": 11.65,
      "text": "Teşekkürler Sema Hanım."
    },
    {
      "idx": 4,
      "speaker": "musteri",
      "start": 12.0,
      "end": 13.2,
      "text": "Faturam yüksek geldi."
    },
    {
      "idx": 5,
      "speaker": "temsilci",
      "start": 13.55,
      "end": 16.35,
      "text": "Size en ucuz paketimizi tanımlayayım, 149 TL."
    },
    {
      "idx": 6,
      "speaker": "musteri",
      "start": 16.7,
      "end": 18.7,
      "text": "Ama ben çok internet kullanıyorum."
    },
    {
      "idx": 7,
      "speaker": "temsilci",
      "start": 19.05,
      "end": 21.05,
      "text": "O paket 10 GB veriyor."
    },
    {
      "idx": 8,
      "speaker": "musteri",
      "start": 21.4,
      "end": 22.6,
      "text": "Yetmez ki bana."
    },
    {
      "idx": 9,
      "speaker": "temsilci",
      "start": 22.95,
      "end": 25.35,
      "text": "Peki o zaman mevcut paketinizde kalın."
    },
    {
      "idx": 10,
      "speaker": "temsilci",
      "start": 25.7,
      "end": 28.5,
      "text": "Başka yardımcı olabileceğim bir konu var mı?"
    },
    {
      "idx": 11,
      "speaker": "musteri",
      "start": 28.85,
      "end": 30.05,
      "text": "Yok, teşekkürler."
    },
    {
      "idx": 12,
      "speaker": "temsilci",
      "start": 30.4,
      "end": 33.2,
      "text": "Aradığınız için teşekkür ederim, iyi günler dilerim."
    }
  ]
