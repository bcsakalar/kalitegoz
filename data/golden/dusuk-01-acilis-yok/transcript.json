    {
      "idx": 2,
      "speaker": "temsilci",
      "start": 4.9,
      "end": 8.5,
      "text": "Görüşmemiz kayıt altına alınmakta, verileriniz KVKK kapsamında işlenmektedir. Adınız?"
    },
    {
      "idx": 3,
      "speaker": "musteri",
      "start": 8.85,
      "end": 10.05,
      "text": "Cem Arslan, 220118."
    },
    {
      "idx": 4,
      "speaker": "temsilci",
      "start": 10.4,
      "end": 12.8,
      "text": "Faturanız 340 TL, son ödeme 25'i."
    },
    {
      "idx": 5,
      "speaker": "musteri",
      "start": 13.15,
      "end": 14.75,
      "text": "Neden bu kadar yüksek?"
    },
    {
      "idx": 6,
      "speaker": "temsilci",
      "start": 15.1,
      "end": 16.3,
      "text": "Kullanımınız fazla olmuş."
    },
    {
      "idx": 7,
      "speaker": "musteri",
      "start": 16.65,
      "end": 17.85,
      "text": "Detayını görebilir miyim?"
