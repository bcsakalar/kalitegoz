{
  "id": "dusuk-08-gecistirme",
  "title": "Musteri sorusu gecistirildi",
  "bucket": "dusuk",
  "tags": [
    "agir_eksik"
  ],
  "duration_sec": 30.65,
  "segments": [
    {
      "idx": 0,
      "speaker": "temsilci",
      "start": 1.0,
      "end": 5.8,
      "text": "Netik İletişim, ben Ege. Görüşmemiz kayıt altına alınmakta, verileriniz KVKK kapsamında işlenmektedir."
    },
    {
      "idx": 1,
      "speaker": "temsilci",
      "start": 6.15,
      "end": 8.55,
      "text": "Adınızı ve müşteri numaranızı alabilir miyim?"
    },
    {
      "idx": 2,
      "speaker": "musteri",
      "start": 8.9,
      "end": 10.1,
      "text": "Tuğçe Bal, 771003."
    },
    {
      "idx": 3,
      "speaker": "musteri",
      "start": 10.45,
      "end": 13.25,
      "text": "Geçen hafta söz verilen indirim faturama yansımamış."
    },
    {
      "idx": 4,
      "speaker": "temsilci",
      "start": 13.6,
      "end": 15.2,
      "text": "Sistemde indirim kaydı göremiyorum."
    },
    {
      "idx": 5,
      "speaker": "musteri",
      "start": 15.55,
      "end": 16.75,
      "text": "Ama telefonda söylediniz."
    },
    {
      "idx": 6,
      "speaker": "temsilci",
      "start": 17.1,
      "end": 18.7,
      "text": "Kim söylediyse ona sorun."
    },
    {
      "idx": 7,
      "speaker": "musteri",
      "start": 19.05,
      "end": 20.25,
      "text": "Nasıl yani?"
    },
    {
      "idx": 8,
      "speaker": "temsilci",
      "start": 20.6,
      "end": 21.8,
      "text": "Ben göremiyorum efendim."
    },
    {
      "idx": 9,
      "speaker": "temsilci",
      "start": 22.15,
      "end": 24.95,
      "text": "Başka yardımcı olabileceğim bir konu var mı?"
    },
    {
      "idx": 10,
      "speaker": "musteri",
      "start": 25.3,
      "end": 26.5,
      "text": "Yok, teşekkürler."
    },
    {
      "idx": 11,
      "speaker": "temsilci",
      "start": 26.85,
      "end": 29.65,
      "text": "Aradığınız için teşekkür ederim, iyi günler dilerim."
    }
  ]
}