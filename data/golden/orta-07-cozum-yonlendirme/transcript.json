      "idx": 0,
      "speaker": "temsilci",
      "start": 1.0,
      "end": 5.8,
      "text": "Netik İletişim, ben Sinem. Görüşmemiz kayıt altına alınmakta, verileriniz KVKK kapsamında işlenmektedir."
    },
    {
      "idx": 1,
      "speaker": "temsilci",
      "start": 6.15,
      "end": 8.55,
      "text": "Adınızı ve müşteri numaranızı alabilir miyim?"
    },
    {
      "idx": 2,
      "speaker": "musteri",
      "start": 8.9,
      "end": 10.1,
      "text": "Kaan Öz, 445188."
    },
    {
      "idx": 3,
      "speaker": "temsilci",
      "start": 10.45,
      "end": 11.65,
      "text": "Teşekkürler Kaan Bey."
    },
    {
      "idx": 4,
      "speaker": "musteri",
      "start": 12.0,
      "end": 14.0,
      "text": "Kurumsal hattımı bireysele çevirmek istiyorum."
    },
    {
      "idx": 5,
      "speaker": "temsilci",
      "start": 14.35,
      "end": 18.35,
      "text": "Bu işlem bizim ekranımızda yapılmıyor, kurumsal müşteri hizmetlerini aramanız gerekiyor."
    },
    {
      "idx": 6,
      "speaker": "musteri",
      "start": 18.7,
      "end": 19.9,
      "text": "Numarayı verebilir misiniz?"
    },
    {
      "idx": 7,
      "speaker": "temsilci",
      "start": 20.25,
      "end": 21.45,
      "text": "444 0 555."
    },
    {
      "idx": 8,
      "speaker": "musteri",
      "start": 21.8,
      "end": 23.0,
      "text": "Peki, arayayım."
    },
    {
      "idx": 9,
      "speaker": "temsilci",
      "start": 23.35,
      "end": 26.15,
      "text": "Başka yardımcı olabileceğim bir konu var mı?"
    },
    {
      "idx": 10,
      "speaker": "musteri",
      "start": 26.5,
      "end": 27.7,
      "text": "Yok, teşekkürler."
    },
    {
      "idx": 11,
      "speaker": "temsilci",
      "start": 28.05,
      "end": 30.85,
      "text": "Aradığınız için teşekkür ederim, iyi günler dilerim."
    }
  ]
