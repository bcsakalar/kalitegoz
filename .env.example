# =====================================================================
# KaliteGöz — yapılandırma şablonu
# =====================================================================
#
# Bu dosyayı ELLE doldurmanıza gerek yok:
#
#     ./scripts/generate-secrets.sh
#
# komutu tüm sırları üretip .env dosyasını oluşturur.
#
# Sırlar burada BOŞ bırakılmıştır — bir şablonda gerçek değer bulunması,
# er ya da geç o değerin üretime taşınması demektir. Boş bırakılan zorunlu
# bir alan varsa uygulama açık bir Türkçe hata mesajıyla durur.
#
# =====================================================================


# ---------------------------------------------------------------------
# UYGULAMA
# ---------------------------------------------------------------------

# development | production. production'da güvenlik ayarları DENETLENİR ve
# uygun değilse uygulama başlamaz (zayıf JWT, açık demo, CORS=*).
ENVIRONMENT=development

# Tarayıcının API'ye eriştiği adres. Docker dışından bakıldığı için localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# SSO sonrası tarayıcının yönlendirileceği panel adresi.
FRONTEND_URL=http://localhost:3000

# İzin verilen kaynaklar. Üretimde "*" YASAK — kendi alan adınızı yazın.
CORS_ORIGINS=*

# IP başına dakikalık istek sınırı. Panolar tek sayfada çok istek attığı
# için cömert tutulur.
RATE_LIMIT_PER_MIN=1000

# Panelde markanızı gösterir; kurum ayarlarından da değiştirilebilir.
BRAND_NAME=KaliteGoz
BRAND_COLOR=#2563eb


# ---------------------------------------------------------------------
# VERİTABANI
# ---------------------------------------------------------------------

# Postgres kullanıcı adı ve veritabanı adı.
POSTGRES_USER=kalitegoz
POSTGRES_DB=kalitegoz

# ZORUNLU — generate-secrets.sh üretir (24 bayt rastgele).
POSTGRES_PASSWORD=

# ZORUNLU — yukarıdaki parolayla tutarlı olmalı; betik ikisini birlikte yazar.
DATABASE_URL=


# ---------------------------------------------------------------------
# REDIS
# ---------------------------------------------------------------------

# ZORUNLU — Celery kuyruğu ve önbellek.
REDIS_URL=redis://redis:6379/0


# ---------------------------------------------------------------------
# OLLAMA / YAPAY ZEKÂ
# ---------------------------------------------------------------------
#
# ÖNEMLİ: Ollama HOST makinede çalışır, Docker'da DEĞİL. Sebep: GPU erişimi,
# model dosyası boyutu ve modelin bellekte kalması. Ayrıntı: docs/MIMARI.md
#
# Modeller kurulmadan puanlama çalışmaz:
#     ollama pull qwen2.5:7b-instruct
#     ollama pull nomic-embed-text

# Konteynerlerin host'taki Ollama'ya eriştiği adres.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Varsayılan sağlayıcı: ollama (yerel) | gemini | openai | openrouter.
# Yerel dışı seçilirse VERİ KURUM DIŞINA ÇIKAR — güvenlik sayfası uyarır.
LLM_PROVIDER=ollama

# Puanlama modeli. Kurum panelden değiştirebilir; bu yalnızca ilk varsayılan.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Bağlam penceresi. CHUNK_THRESHOLD_SEC ile uyumlu olmalı; küçültülürse
# uzun çağrılarda prompt sessizce kırpılır ve puanlama bozulur.
OLLAMA_NUM_CTX=8192

# Model bellekte ne kadar kalsın. Kısaltmak her çağrıda yeniden yükleme demek.
OLLAMA_KEEP_ALIVE=5m

# Ollama'nın kullanacağı çekirdek sayısı ve konteyner kaynak tavanları.
OLLAMA_NUM_THREAD=4
OLLAMA_CPUS=4
OLLAMA_MEM=8g
WORKER_CPUS=4
WORKER_MEM=3g

# LLM isteği zaman aşımı (sn) ve yeniden deneme sayısı.
LLM_TIMEOUT_SEC=1200
LLM_MAX_RETRIES=1

# Bilgi bankası (RAG) araması için gömme modeli.
EMBED_MODEL=nomic-embed-text
RAG_ENABLED=true

# Görsel/ek dosya denetimi (opsiyonel).
VISION_ENABLED=true
OLLAMA_VISION_MODEL=qwen3-vl:4b

# Yerel modele giden metinde PII maskelensin mi. Yerel modelde veri zaten
# kurumdan çıkmadığı için varsayılan kapalı; bulut sağlayıcıda açın.
MASK_LOCAL_LLM=false

# Bulut sağlayıcı anahtarları — boş bırakılırsa o sağlayıcı kullanılamaz.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_VISION_MODEL=gemini-2.0-flash

# Ses çözümleme (Whisper). Model büyüdükçe doğruluk artar, hız düşer.
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=tr

# Konuşmacı ayrımı için HuggingFace erişim jetonu. Boşsa mono kayıtlarda
# konuşmacı ayrımı yapılamaz ve uyum kontrolleri zayıflar.
HF_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1

# Uzun çağrı parçalama eşiği ve parça boyu (saniye).
CHUNK_THRESHOLD_SEC=600
CHUNK_SIZE_SEC=480


# ---------------------------------------------------------------------
# GÜVENLİK VE SIRLAR
# ---------------------------------------------------------------------
#
# Hepsini generate-secrets.sh üretir. BOŞ BIRAKILAMAZ — boşsa uygulama
# açık bir Türkçe hata mesajıyla durur, sessizce varsayılana kaçmaz.

# ZORUNLU — oturum jetonlarını imzalar (48 bayt rastgele).
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14

# ZORUNLU — oturum/CSRF imzası. JWT_SECRET'tan ayrı olması, biri sızarsa
# diğerinin geçerli kalmasını sağlar.
SESSION_SECRET=

# ZORUNLU — başlangıç kullanıcılarının parolası (yönetici dahil).
# Varsayılanı yoktur: herkesin bildiği bir parola, parola değildir.
ADMIN_PASSWORD=

# Diskte şifreleme ana anahtarı. DOSYADAN okunur, ortam değişkeninden değil:
# ortam değişkenleri `docker inspect` ve /proc/<pid>/environ üzerinden sızar.
# Kesintisiz rotasyon ve KMS/Vault entegrasyonu: docs/KVKK-UYUM.md §3.1-3.2
KG_MASTER_KEY_FILE=/run/secrets/kg_master_key
KG_MASTER_KEY_ID=
# Rotasyon penceresi: eski anahtarlarla OKUMA sürer, yeni anahtarla YAZILIR.
KG_MASTER_KEY_OLD_FILES=
ENCRYPTION_AT_REST=false

# Demo giriş (parolasız rol seçimi). Üretimde MUTLAKA false.
DEMO_MODE=true

# Transkript ve raporlarda kişisel veriyi maskele.
PII_MASKING_ENABLED=true

# Harici sistemlerin (santral/CRM) /api/v1/ingest'e POST edebilmesi için
# X-Ingest-Key değeri. Boşsa push-ingest kapalıdır.
INGEST_API_KEY=


# ---------------------------------------------------------------------
# SSO / OIDC
# ---------------------------------------------------------------------
#
# Bu ayarlar Yönetim → Kurumsal Kimlik ekranından da girilebilir ve
# PANEL AYARI ORTAM DEĞİŞKENİNİ EZER. Buradakiler yalnızca ilk varsayılandır.

SSO_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
# SSO ile ilk kez giren kullanıcıya verilecek rol ve kiracı.
OIDC_DEFAULT_ROLE=agent
OIDC_DEFAULT_TENANT=demo


# ---------------------------------------------------------------------
# KVKK VE SAKLAMA
# ---------------------------------------------------------------------

# Ses ve transkriptlerin tutulduğu dizinler (konteyner içi yollar).
STORAGE_DIR=/data/storage
# İzlenen klasör: buraya bırakılan ses dosyaları otomatik alınır.
WATCH_DIR=/data/inbox

# İhlal/kriz olaylarının POST edileceği adresler (virgülle).
WEBHOOK_URLS=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# Hangi olaylar bildirilsin: zeroing, crisis, banned_word, low_score, score_drop
NOTIFY_EVENTS=zeroing,crisis

# Zamanlanmış e-posta raporu. SMTP_HOST boşsa gönderilmez, yalnızca loglanır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kalitegoz@localhost
SMTP_USE_TLS=true
REPORT_RECIPIENTS=


# ---------------------------------------------------------------------
# DEMO
# ---------------------------------------------------------------------

# Başlangıçta oluşturulacak örnek çağrı sayısı. Bu çağrılar "bekliyor"
# durumunda gelir — puanlama, transkript ve alarm YOKTUR. İşlemeyi
# Yönetim → İşleme ekranından siz başlatırsınız.
#
# 0 yaparsanız sistem tamamen boş açılır.
DEMO_CALL_COUNT=20
