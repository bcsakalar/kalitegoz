# =====================================================================
# KaliteGoz yapilandirmasi — kopyalayin: cp .env.example .env
# (make demo bunu otomatik yapar)
# =====================================================================

# --- PostgreSQL (pgvector'lu imaj; RAG icin `vector` eklentisi hazir) ---
POSTGRES_USER=kalitegoz
POSTGRES_PASSWORD=kalitegoz
POSTGRES_DB=kalitegoz

# Backend baglanti adresleri (compose ici servis adlari)
DATABASE_URL=postgresql+psycopg://kalitegoz:kalitegoz@postgres:5432/kalitegoz
REDIS_URL=redis://redis:6379/0

# --- Guvenlik / Auth (JWT) ---
# PRODUCTION'DA MUTLAKA DEGISTIRIN (en az 32 karakter rastgele)
JWT_SECRET=kalitegoz-dev-secret-CHANGE-IN-PROD
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
# Demo modu: landing sayfasindan rol secip parolasiz giris (PROD'DA false YAPIN)
DEMO_MODE=true

# --- Depolama (konteyner ici yollar; ./data host klasorune mount edilir) ---
STORAGE_DIR=/data/storage
WATCH_DIR=/data/inbox

# --- STT (faster-whisper) ---
# WHISPER_DEVICE: auto | cuda | cpu  (auto: CUDA dener, olmazsa CPU'ya duser)
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=tr

# --- Diarization ---
# Stereo kayitlarda kanal ayrimi kullanilir, pyannote'a gerek YOKTUR.
# Mono kayitlarda pyannote istiyorsaniz HuggingFace token girin ve imaji
# --build-arg WITH_DIARIZATION=1 ile derleyin.
HF_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1

# =====================================================================
# KAYNAK KULLANIMI (CPU/RAM) — makinenizi bogmamasi icin
# =====================================================================
# Olculen varsayilan davranis (12 cekirdek / 11.7 GB Docker VM):
#   Ollama sinirsiz biraktiginda ~5.5 cekirdek (%550 CPU) + 6.5 GB RAM kapiyor.
# Asagidaki degerler bunu sinirlar. GPU'ya gecerseniz yukseltebilirsiniz.

# Ollama cikarim thread sayisi (ana CPU tuketicisi). Dusurmek CPU'yu rahatlatir,
# puanlamayi yavaslatir. 0/bos birakilirsa llama.cpp tum cekirdekleri kapar.
OLLAMA_NUM_THREAD=4
# Ollama container CPU/RAM tavani
OLLAMA_CPUS=4
OLLAMA_MEM=8g
# Model bellekte ne kadar kalsin? Kisa=RAM erken serbest kalir ama sonraki
# istekte model yeniden yuklenir (~70 sn). Uzun=hizli ama bosta ~5-6 GB tutar.
OLLAMA_KEEP_ALIVE=5m
# STT worker (Whisper medium ~1.5 GB)
WORKER_CPUS=4
WORKER_MEM=3g

# --- LLM saglayici: ollama | gemini ---
LLM_PROVIDER=ollama
# Ollama PC'de (host) NATIVE calisir (Docker degil). Docker container'lari host
# Ollama'ya host.docker.internal ile erisir; host worker 127.0.0.1 kullanir.
# Kurulum rehberi: NATIVE-AI-KURULUM.md
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# Baglam penceresi. Buyutmek KV cache'i (RAM) sisirir; 8192 tipik cagri icin
# yeterlidir (uzun cagrilar CHUNK_THRESHOLD_SEC ile parcalanir).
OLLAMA_NUM_CTX=8192
# LLM_PROVIDER=gemini yaparsaniz asagidakileri doldurun:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Ollama tek slotla calisir (OLLAMA_NUM_PARALLEL=1) ve istekler sunucuda siraya
# girer; CPU'da 7B model yavas oldugu icin timeout comert tutulur.
LLM_TIMEOUT_SEC=1200
# JSON parse hatasinda repair-prompt deneme sayisi
LLM_MAX_RETRIES=1

# --- Bilgi bankasi / RAG (yanlis bilgi tespiti) ---
# Sirket prosedur/SSS dokumanlari yuklenir; temsilcinin verdigi bilgi bunlarla
# karsilastirilir. Embedding modeli ollama ile otomatik indirilir (~270 MB).
EMBED_MODEL=nomic-embed-text
GEMINI_EMBED_MODEL=text-embedding-004
RAG_ENABLED=true

# --- Vision (gorsel/ek dosya denetimi) ---
VISION_ENABLED=false
OLLAMA_VISION_MODEL=llava:7b
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- KVKK / maskeleme ---
# Harici LLM'e (Gemini) giden metin HER ZAMAN maskelenir (kod garantisi).
# Ollama yerel oldugu icin varsayilan maskelemez; true yaparsaniz yerelde de maskelenir.
MASK_LOCAL_LLM=false

# --- Uzun cagri map-reduce ---
# Esik OLLAMA_NUM_CTX ile uyumlu olmali: ~10 dk transkript + rubrik + RAG
# pasajlari 8192 token'a sigar. Esigi buyutuyorsaniz NUM_CTX'i de buyutun,
# yoksa prompt sessizce kirpilir.
CHUNK_THRESHOLD_SEC=600
CHUNK_SIZE_SEC=480

# --- Webhook (ihlal/kriz olaylari makine-makine JSON POST edilir; CRM) ---
# Virgul ile ayrilmis URL listesi.
WEBHOOK_URLS=

# --- Slack / Teams bildirimi (insana okunur mesaj; Dalga 4b) ---
# Incoming webhook URL'leri (bos ise gonderilmez). Ikisi de {"text": ...} kabul eder.
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# Hangi olaylar dussun (virgulle): zeroing,crisis,banned_word,low_score,score_drop
NOTIFY_EVENTS=zeroing,crisis

# --- SMTP zamanlanmis e-posta raporu (Dalga 7) ---
# Bos ise rapor uretilir ama gonderilmez. Her pazartesi 08:30'da haftalik ekip raporu.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kalitegoz@localhost
SMTP_USE_TLS=true
# Raporun gidecegi adresler (virgulle)
REPORT_RECIPIENTS=

# --- Vision (chat'e ekli gorsel denetimi; Dalga 5) ---
# Acmak icin true yapin VE modeli cekin: ollama pull llava:7b (~4.7 GB)
VISION_ENABLED=false
OLLAMA_VISION_MODEL=llava:7b
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- KVKK: saklanan transkript maskeleme (kurumsal/on-prem) ---
# true: /calls/{id} transkript/ozet MASKELI doner; yalnizca admin/kalite
# ?reveal=true ile ham veriyi gorur ve bu erisim denetime yazilir.
PII_MASKING_ENABLED=true

# --- SSO / OIDC (kurumsal tek oturum acma; Okta/Entra/Keycloak/Google) ---
# Bos/false ise SSO kapali; parola+demo giris calisir. Acmak icin:
SSO_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
OIDC_DEFAULT_ROLE=agent
OIDC_DEFAULT_TENANT=demo
FRONTEND_URL=http://localhost:3000

# --- Beyaz etiket (white-label) varsayilanlari ---
# Tenant kendi markasini ayarlayana kadar bu degerler kullanilir.
BRAND_NAME=KaliteGoz
BRAND_COLOR=#2563eb

# --- Push-ingest konnektor (santral/CRM webhook -> gercek zamanli cagri) ---
# Bos ise kapali. Doldurulursa X-Ingest-Key basligiyla POST /api/v1/ingest/call.
INGEST_API_KEY=

# --- Guvenlik durusu beyani (guvenlik sayfasinda gosterilir) ---
# Diskte sifreleme OS/volume seviyesinde saglaniyorsa true yapin (beyan amacli).
ENCRYPTION_AT_REST=false

# --- Guvenlik ---
CORS_ORIGINS=*
# SPA panolari cok istek attigi icin comert; 429 dondugunde bile CORS basligi eklenir
RATE_LIMIT_PER_MIN=1000

# --- Frontend (build sirasinda gomulur; tarayicidan gorunen API adresi) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
